# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=abhiknow
POSTGRES_USER=abhiknow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Contact email sent to providers that ask for identification (Crossref, OpenAlex polite pool)
ABHIKNOW_CONTACT_EMAIL=you@example.com

# Per-provider timeout in milliseconds
ABHIKNOW_PROVIDER_TIMEOUT_MS=8000

# Backend connection (defaults match docker-compose and a local PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/abhiknow

# Optional. OpenAlex needs a free key in practice: https://help.openalex.org/api/authentication/
OPENALEX_API_KEY=

# Allowed browser origins for the API (comma separated)
ABHIKNOW_CORS_ORIGINS=http://localhost:5173
